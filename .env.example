# ─── Supabase ───────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-supabase-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ─── Google Gemini ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model list (comma-separated, first available wins)
# GEMINI_MODEL=gemini-2.5-flash,gemini-3.6-flash,gemini-3.5-flash

# ─── Medicine Reference Build (only needed for scripts/build-medicine-reference.mjs) ───
# OPENFDA_API_KEY=your-openfda-key-here

# ─── Feature Flags (safe defaults — all on) ────────────────
# VITE_FEATURE_LLM_CONTEXT=true
# VITE_FEATURE_MEDICINE_PHOTO=true
# VITE_FEATURE_MEDICINE_SETS=false
# VITE_FEATURE_EXPIRY=false
# VITE_FEATURE_TREND=false
